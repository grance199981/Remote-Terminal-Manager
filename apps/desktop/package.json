{
  "name": "@remote-control/desktop",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "main": "dist/main/main.js",
  "description": "Electron desktop SSH and local terminal manager.",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "clean": "node scripts/clean-dist.cjs",
    "build": "npm run clean && npm run typecheck && vite build && tsc -p tsconfig.main.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win portable --x64 --config.directories.output=release-v0.2.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "42.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "local.remote-terminal-manager",
    "productName": "Remote Terminal Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Remote-Terminal-Manager-v${version}-portable-${arch}.${ext}"
    },
    "electronVersion": "42.2.0",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "electronDist": "../../node_modules/electron/dist"
  },
  "author": "zijia"
}
